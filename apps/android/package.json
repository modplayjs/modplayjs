  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "build:engine": "esbuild engine/src/engine-monolith.ts --bundle --format=iife --target=es2022 --platform=neutral --legal-comments=none --outfile=app/src/main/assets/engine/engine.js",
