<?xml version="1.0" encoding="utf-8"?>
<!--
  VRC.Quest.Packaging.4 asks for a valid network security configuration in the
  manifest. The only network use is the engine-module catalog: one HTTPS JSON
  document plus the module files it lists, no cleartext, no user-installed CAs,
  no debug override. Songs are never fetched. That is also what targetSdk 34
  enforces implicitly; stating it keeps the upload check and the code in
  agreement.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
