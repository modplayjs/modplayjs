<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:metavr="http://schemas.meta.com/metavr-sdk"
    android:installLocation="auto">

    <!-- Meta VR OS SDK versioning, not the Android API level. `uses-metavr-sdk`
         is the current element; Horizon OS still parses the older
         `horizonos:uses-horizonos-sdk`, but Meta points new work at this one and
         this project does not carry both. The numbers are the Meta VR OS SDK
         API level (207 is the current line, the version of the compileOnly
         JSDK), not the Android API level. Spatial SDK 0.15's own manifest
         template declares 207/207, so minSdkVersion 69 (the old hybrid-app
         floor) was claiming compatibility with OS versions the SDK does not
         support. -->
    <metavr:uses-metavr-sdk
        metavr:minSdkVersion="207"
        metavr:targetSdkVersion="207" />

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />
    <uses-feature android:glEsVersion="0x00030001" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <!-- Text input (library search) uses the system keyboard in immersive mode.
         Both optional, exactly as the Spatial SDK manifest template lists them. -->
    <uses-feature android:name="com.oculus.feature.VIRTUAL_KEYBOARD" android:required="false" />
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />

    <!-- Hands and controllers. The permission is the one Meta actually defines:
         `com.oculus.permission.HAND_TRACKING`. The native hand-tracking page
         ("Add Flag to Android Manifest"), the Spatial SDK manifest template in
         "Add Spatial SDK to an existing 2D app", and every Spatial SDK sample
         (Starter, Object3D-ISDK, BodyTracking, MixedReality, Hybrid) declare
         exactly this pair with `oculus.software.handtracking` required=false.

         `horizonos.permission.HAND_TRACKING` is not it. It appears nowhere in
         Meta's documentation - 0 occurrences across the native, android-apps,
         spatial-sdk and resources corpora - and a device proves it: declaring
         and requesting it leaves the process without the grant, so the runtime
         refuses the hand tracker and logcat shows
         `MemoryBrokerClient: Hands: failed to remap HAND_TRACKER (missing
         runtime permission(s))`. Declaring the documented name is what turns
         hands on.

         required=false = "controllers and hands", and both modalities reach
         every interaction: Interaction SDK gives hands a ray, direct touch on
         panels and grabbing, exactly like the controllers. -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <!-- Engine module updates: one JSON catalog plus the files it lists.
         Songs are never downloaded; this is the decoder/mixer layer only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scene model for room geometry (walls, furniture). Both are required by
         MRUK; the horizonos.permission.* aliases are system-granted implicitly
         and are not documented as declarable, so the com.oculus names stay. -->
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />
    <uses-permission android:name="com.oculus.permission.USE_ANCHOR_API" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <!-- VRC.Quest.Functional.14: the app can start straight into passthrough
             (Skybox follows scene.isSystemPassthroughEnabled), so the system
             loading screen has to keep the room visible instead of flashing black. -->
        <meta-data
            android:name="com.oculus.ossplash.background"
            android:value="passthrough-contextual" />

        <!-- Public runtime library the Spatial SDK loads itself. required=false:
             a required entry makes the installer abort with
             INSTALL_FAILED_MISSING_SHARED_LIBRARY on builds that do not expose
             it to third-party apps, while System.loadLibrary still resolves it
             at runtime when it is present. -->
        <uses-native-library android:name="libossdk.oculus.so" android:required="false" />

        <activity
            android:name="com.bitti06.modplayjs.xr.XrActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
