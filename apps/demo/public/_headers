# Workers static assets reads this file; it is never served itself.
#
# The audio transport prefers a SharedArrayBuffer ring, which the browser only
# exposes when the document is cross-origin isolated. Workers can set these
# headers at the edge, so the first visit is already isolated — the service
# worker's COI injection is only a fallback.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite writes every bundle under /assets/ with a content hash in its name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
