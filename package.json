{
  "name": "modplayjs",
  "private": true,
  "version": "0.0.1",
  "description": "Browser tracker player library (MOD/S3M/XM/IT), ported from OpenMPT/libxmp/Paula-Tracker",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --filter=@modplayjs/demo"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "i": "^0.3.7",
    "npm": "^12.0.2",
    "stb-vorbis": "^0.0.6"
  },
  "packageManager": "npm@11.17.0",
  "license": "BSD-3-Clause",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
