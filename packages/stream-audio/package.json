{
  "name": "@modplayjs/stream-audio",
  "version": "0.1.1",
  "description": "MP3 / WAV / OGG streamed-audio decode for modplayjs (minimp3 + stb_vorbis ports).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modplayjs/fmt-mo3": "*",
    "@modplayjs/stb-vorbis": "*"
  },
  "keywords": [
    "mp3",
    "wav",
    "ogg",
    "vorbis",
    "audio"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modplayjs/modplayjs.git",
    "directory": "packages/stream-audio"
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
