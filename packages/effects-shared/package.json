{
  "name": "@modplayjs/effects-shared",
  "version": "0.0.4",
  "description": "Compatibility shim re-exporting the effects processor from @modplayjs/core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modplayjs/core": "^0.0.2"
  },
  "keywords": [
    "tracker",
    "mod",
    "s3m",
    "xm",
    "it",
    "libxmp",
    "chiptune",
    "audio",
    "music"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modplayjs/modplayjs.git",
    "directory": "packages/effects-shared"
  },
  "bugs": "https://github.com/modplayjs/modplayjs/issues",
  "homepage": "https://github.com/modplayjs/modplayjs#readme",
  "license": "BSD-3-Clause"
}
