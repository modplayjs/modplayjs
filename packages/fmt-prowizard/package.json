{
  "name": "@modplayjs/fmt-prowizard",
  "version": "0.3.0",
  "description": "ProWizard packed-MOD depackers for modplayjs (libxmp loaders/prowizard port).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modplayjs/core": "^0.2.0",
    "@modplayjs/fmt-mod": "^0.2.0"
  },
  "keywords": [
    "tracker",
    "prowizard",
    "propacker",
    "theplayer",
    "packed mod",
    "libxmp",
    "chiptune",
    "audio",
    "music"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modplayjs/modplayjs.git",
    "directory": "packages/fmt-prowizard"
  },
  "bugs": "https://github.com/modplayjs/modplayjs/issues",
  "homepage": "https://github.com/modplayjs/modplayjs#readme",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
