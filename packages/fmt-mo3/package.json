{
  "name": "@modplayjs/fmt-mo3",
  "version": "0.2.2",
  "description": "Un4seen MO3 container (XM/IT/S3M/MOD/MTM inner) format plugin for modplayjs (OpenMPT Load_mo3.cpp port).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./minimp3.js": {
      "types": "./dist/minimp3.d.ts",
      "import": "./dist/minimp3.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modplayjs/core": "^0.2.2",
    "@modplayjs/fmt-mod": "^0.2.2",
    "@modplayjs/stb-vorbis": "^0.2.2"
  },
  "keywords": [
    "mo3",
    "stm",
    "scream tracker",
    "libxmp",
    "chiptune",
    "audio",
    "music"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modplayjs/modplayjs.git",
    "directory": "packages/fmt-mo3"
  },
  "bugs": "https://github.com/modplayjs/modplayjs/issues",
  "homepage": "https://github.com/modplayjs/modplayjs#readme",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
