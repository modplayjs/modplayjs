{
  "name": "@modplayjs/stb-vorbis",
  "version": "0.2.1",
  "description": "stb_vorbis Ogg Vorbis decoder (OpenMPT stb_vorbis.c port) for modplayjs (OpenMPT stb_vorbis.c port).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vorbis.js": {
      "types": "./dist/vorbis.d.ts",
      "import": "./dist/vorbis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modplayjs/core": "^0.2.1",
    "@modplayjs/fmt-mod": "^0.2.1"
  },
  "keywords": [
    "mo3",
    "stm",
    "scream tracker",
    "libxmp",
    "chiptune",
    "audio",
    "music"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modplayjs/modplayjs.git",
    "directory": "packages/stb-vorbis"
  },
  "bugs": "https://github.com/modplayjs/modplayjs/issues",
  "homepage": "https://github.com/modplayjs/modplayjs#readme",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
